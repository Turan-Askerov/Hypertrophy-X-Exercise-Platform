# Hypertrophy-X v4.1 — Ortam Değişkenleri
# Yerelde: cp .env.example .env
# Canlıda bu değerleri GitHub'a değil, hosting sağlayıcısının Secrets/Variables alanına girin.

# development | test | production
APP_ENV=development

# PostgreSQL bağlantısı
# Yerelde DATABASE_URL boş bırakılırsa eski backend/hypertrophy.db ile çalışma sürer.
# Production'da DATABASE_URL zorunludur.
# Örnek: postgresql://kullanici:parola@host:5432/hypertrophy
DATABASE_URL=

# Eski SQLite dosyasının yolu. Bu dosya migration aracı tarafından silinmez veya değiştirilmez.
DB_PATH=hypertrophy.db

# Admin hesabı
# Production'da en az 12 karakterlik, benzersiz güçlü parola zorunludur.
ADMIN_USERNAME=xxx
ADMIN_PASSWORD=xxx

# JWT oturum imza anahtarı
# Production'da en az 32 karakterlik rastgele bir değer zorunludur.
# Üretim: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=YEREL-GELISTIRME-ICIN-EN-AZ-32-KARAKTERLIK-BIR-ANAHTAR-DEGISTIR

# CORS
# Development'ta * kullanılabilir. Production'ta yalnızca HTTPS originleri kullanın.
# Çoklu origin örneği: https://uygulama.example,https://www.uygulama.example
CORS_ORIGIN=*

# HTTPS özel domain tamamen çalıştıktan sonra production'da true yapılabilir.
ENABLE_HSTS=false

# Login/register kaba kuvvet koruması: aynı IP için 15 dakikada en fazla 10 deneme.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# Railway/Render gibi ters proxy arkasında gerçek istemci IP'sini kullanmak için true yapın.
TRUST_PROXY_HEADERS=false

# Sunucu portu. PaaS sağlayıcıları kendi PORT değerini verebilir.
PORT=8000

