# Hypertrophy-X v4.0 — Örnek Ortam Değişkenleri Şablonu
# Bu dosyayı kopyalayarak backend/.env oluşturun ve kendi değerlerinizi girin:
# cp backend/.env.example backend/.env

# Admin hesabı
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# JWT oturum anahtarı — 32+ karakterlik rastgele güvenli değer
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long

# CORS Origin (Frontend URL)
CORS_ORIGIN=http://localhost:8000

# Sunucu portu
PORT=8000

# Veritabanı bağlantısı (Neon PostgreSQL veya SQLite)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
